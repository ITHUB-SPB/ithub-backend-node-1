{
  "name": "ithub-nodejs-fundamentals",
  "version": "1.0.0",
  "description": "Node.js Fundamentals assignment repository",
  "engines": {
    "node": ">=24.10.0",
    "npm": ">=10.9.2"
  },
  "type": "module",
  "scripts": {
    "snapshot": "node src/fs/snapshot.js",
